server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;

  # Cabeçalhos de segurança: nginx não herda add_header entre níveis, então o arquivo é incluído em cada location.
  include /etc/nginx/security-headers.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # arquivos com hash no nome podem ficar em cache por muito tempo
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  # PWA: o service worker e o manifesto precisam ser revalidados para as atualizações chegarem
  location = /sw.js { add_header Cache-Control "no-cache"; include /etc/nginx/security-headers.conf; try_files $uri =404; }
  location = /manifest.webmanifest { add_header Cache-Control "no-cache"; include /etc/nginx/security-headers.conf; try_files $uri =404; }

  # API e WebSocket na mesma origem do site. Evita bloqueio de CSP/CORS e funciona
  # dentro da rede do Compose pelo nome do serviço, sem expor a porta ao navegador.
  location /api/ {
    proxy_pass http://api:3333;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 75s;
    include /etc/nginx/security-headers.conf;
  }

  # rotas do navegador (react-router) caem no index.html
  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
